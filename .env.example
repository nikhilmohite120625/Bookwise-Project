FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=bookwise-secret-key-change-in-production-2026
# Primary MySQL connection string (leave empty or unset for automatic SQLite fallback in local development)
DATABASE_URL=
