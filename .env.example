FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Primary Database Connection:
# In development, leave empty or unset for automatic SQLite fallback (instance/bookwise.db).
# In production (Render/AWS/etc.), supply DATABASE_URL or discrete DB_* variables below:
DATABASE_URL=
# Example PostgreSQL (Render default):
# DATABASE_URL=postgresql://user:password@hostname:5432/bookwise_db
# Example MySQL 8:
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/bookwise_db

# Alternative discrete database variables (used if DATABASE_URL is unset):
# DB_DIALECT=postgresql
# DB_USER=bookwise_user
# DB_PASSWORD=your_secure_db_password
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=bookwise_db

# Administrator Account Provisioning (Optional):
# When set, initial database seeding will securely create/update the curator admin with this password.
# You can also create an admin anytime via: flask create-admin
# ADMIN_EMAIL=admin@bookwise.atelier
# ADMIN_PASSWORD=your_secure_admin_password
# ADMIN_NAME=Atelier Curator

# Rate limiting storage (default in-memory)
RATELIMIT_STORAGE_URI=memory://
